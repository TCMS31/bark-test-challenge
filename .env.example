# Copy to .env and adjust. Nothing here is a real credential.
# Anything listed in config/database.yml can also be replaced wholesale by
# setting DATABASE_URL.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=bark_test_challenge_development
TEST_DATABASE_NAME=bark_test_challenge_test

# Puma thread count; config/database.yml sizes the connection pool to match.
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# Production only: set to false when TLS is terminated elsewhere or when
# running the container over plain HTTP.
FORCE_SSL=true

# Required in production only. Generate one with `bin/rails secret`.
SECRET_KEY_BASE=
